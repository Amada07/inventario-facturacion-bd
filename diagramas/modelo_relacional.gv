FACTURAS_ENCABEZADO [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FADADD"><TR><TD COLSPAN="3" BGCOLOR="#2F4F6F"><B><FONT COLOR="white">FACTURAS_ENCABEZADO</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="ID_Factura"><B>ID_Factura</B></TD><TD ALIGN="LEFT">NUMBER</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT" PORT="Numero_Factura">Numero_Factura</TD><TD ALIGN="LEFT">VARCHAR2(20)</TD><TD>UQ</TD></TR><TR><TD ALIGN="LEFT" PORT="Fecha_Emision">Fecha_Emision</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="Subtotal">Subtotal</TD><TD ALIGN="LEFT">NUMBER(12,2)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="Impuesto">Impuesto</TD><TD ALIGN="LEFT">NUMBER(12,2)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="Total_Factura">Total_Factura</TD><TD ALIGN="LEFT">NUMBER(12,2)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="Estado">Estado</TD><TD ALIGN="LEFT">VARCHAR2(15)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="ID_Cliente">ID_Cliente</TD><TD ALIGN="LEFT">NUMBER</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="ID_Empleado">ID_Empleado</TD><TD ALIGN="LEFT">NUMBER</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="ID_Metodo_Pago">ID_Metodo_Pago</TD><TD ALIGN="LEFT">NUMBER</TD><TD>FK</TD></TR></TABLE>>];
