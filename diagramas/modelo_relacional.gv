PRODUCTOS [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DDF2DD"><TR><TD COLSPAN="3" BGCOLOR="#2F4F6F"><B><FONT COLOR="white">PRODUCTOS</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="ID_Producto"><B>ID_Producto</B></TD><TD ALIGN="LEFT">NUMBER</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT" PORT="Codigo_Barras">Codigo_Barras</TD><TD ALIGN="LEFT">VARCHAR2(30)</TD><TD>UQ</TD></TR><TR><TD ALIGN="LEFT" PORT="Nombre_Producto">Nombre_Producto</TD><TD ALIGN="LEFT">VARCHAR2(120)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="Precio_Compra">Precio_Compra</TD><TD ALIGN="LEFT">NUMBER(10,2)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="Precio_Venta">Precio_Venta</TD><TD ALIGN="LEFT">NUMBER(10,2)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="Stock_Actual">Stock_Actual</TD><TD ALIGN="LEFT">NUMBER(10)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="Stock_Minimo">Stock_Minimo</TD><TD ALIGN="LEFT">NUMBER(10)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="ID_Categoria">ID_Categoria</TD><TD ALIGN="LEFT">NUMBER</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="ID_Marca">ID_Marca</TD><TD ALIGN="LEFT">NUMBER</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="ID_Unidad">ID_Unidad</TD><TD ALIGN="LEFT">NUMBER</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="ID_Proveedor">ID_Proveedor</TD><TD ALIGN="LEFT">NUMBER</TD><TD>FK</TD></TR></TABLE>>];
