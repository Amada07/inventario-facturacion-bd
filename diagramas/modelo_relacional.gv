digraph G {
graph [rankdir=LR, splines=polyline, nodesep=0.5, ranksep=1.3, fontname="Helvetica", labelloc=t, fontsize=22, pad=0.4, label="Modelo relacional: FERRETERIADB (14 tablas)"];
node [shape=plaintext, fontname="Helvetica", fontsize=11]
edge [fontname="Helvetica", fontsize=10, arrowsize=1.0, dir=both, color="#444444"]
CATEGORIAS [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DCEBFA"><TR><TD COLSPAN="3" BGCOLOR="#2F4F6F"><B><FONT COLOR="white">CATEGORIAS</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="ID_Categoria"><B>ID_Categoria</B></TD><TD ALIGN="LEFT">NUMBER</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT" PORT="Nombre_Categoria">Nombre_Categoria</TD><TD ALIGN="LEFT">VARCHAR2(60)</TD><TD>UQ</TD></TR><TR><TD ALIGN="LEFT" PORT="Descripcion">Descripcion</TD><TD ALIGN="LEFT">VARCHAR2(255) null</TD><TD></TD></TR></TABLE>>];
