CLIENTES [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DCEBFA"><TR><TD COLSPAN="3" BGCOLOR="#2F4F6F"><B><FONT COLOR="white">CLIENTES</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="ID_Cliente"><B>ID_Cliente</B></TD><TD ALIGN="LEFT">NUMBER</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT" PORT="NIT">NIT</TD><TD ALIGN="LEFT">VARCHAR2(20)</TD><TD>UQ</TD></TR><TR><TD ALIGN="LEFT" PORT="Nombre_Completo">Nombre_Completo</TD><TD ALIGN="LEFT">VARCHAR2(120)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="Direccion">Direccion</TD><TD ALIGN="LEFT">VARCHAR2(200) null</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="Telefono">Telefono</TD><TD ALIGN="LEFT">VARCHAR2(20) null</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="Correo">Correo</TD><TD ALIGN="LEFT">VARCHAR2(100) null</TD><TD>UQ</TD></TR></TABLE>>];
EMPLEADOS [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E8E0F5"><TR><TD COLSPAN="3" BGCOLOR="#2F4F6F"><B><FONT COLOR="white">EMPLEADOS</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="ID_Empleado"><B>ID_Empleado</B></TD><TD ALIGN="LEFT">NUMBER</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT" PORT="Nombre_Completo">Nombre_Completo</TD><TD ALIGN="LEFT">VARCHAR2(120)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="Puesto">Puesto</TD><TD ALIGN="LEFT">VARCHAR2(50)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="Telefono">Telefono</TD><TD ALIGN="LEFT">VARCHAR2(20) null</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="Correo">Correo</TD><TD ALIGN="LEFT">VARCHAR2(100)</TD><TD>UQ</TD></TR><TR><TD ALIGN="LEFT" PORT="Fecha_Ingreso">Fecha_Ingreso</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR></TABLE>>];
