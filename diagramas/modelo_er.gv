COMPRAS_ENCABEZADO [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF1CC"><TR><TD COLSPAN="2" BGCOLOR="#2F4F6F"><B><FONT COLOR="white">COMPRAS_ENCABEZADO</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><B>ID_Compra</B></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">Numero_Compra</TD><TD>UQ</TD></TR><TR><TD ALIGN="LEFT">Fecha_Compra</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Subtotal</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Impuesto</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Total_Compra</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Estado</TD><TD></TD></TR><TR><TD ALIGN="LEFT">ID_Proveedor</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">ID_Empleado</TD><TD>FK</TD></TR></TABLE>>];
COMPRAS_DETALLE [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF1CC"><TR><TD COLSPAN="2" BGCOLOR="#2F4F6F"><B><FONT COLOR="white">COMPRAS_DETALLE</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><B>ID_Detalle_Compra</B></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">ID_Compra</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">ID_Producto</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">Cantidad</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Precio_Unitario</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Subtotal</TD><TD></TD></TR></TABLE>>];
METODOS_PAGO [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FADADD"><TR><TD COLSPAN="2" BGCOLOR="#2F4F6F"><B><FONT COLOR="white">METODOS_PAGO</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><B>ID_Metodo_Pago</B></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">Nombre_Metodo</TD><TD>UQ</TD></TR></TABLE>>];
FACTURAS_ENCABEZADO [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FADADD"><TR><TD COLSPAN="2" BGCOLOR="#2F4F6F"><B><FONT COLOR="white">FACTURAS_ENCABEZADO</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><B>ID_Factura</B></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">Numero_Factura</TD><TD>UQ</TD></TR><TR><TD ALIGN="LEFT">Fecha_Emision</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Subtotal</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Impuesto</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Total_Factura</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Estado</TD><TD></TD></TR><TR><TD ALIGN="LEFT">ID_Cliente</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">ID_Empleado</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">ID_Metodo_Pago</TD><TD>FK</TD></TR></TABLE>>];
FACTURAS_DETALLE [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FADADD"><TR><TD COLSPAN="2" BGCOLOR="#2F4F6F"><B><FONT COLOR="white">FACTURAS_DETALLE</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><B>ID_Detalle</B></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">ID_Factura</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">ID_Producto</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">Cantidad</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Precio_Unitario</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Subtotal</TD><TD></TD></TR></TABLE>>];
MOVIMIENTOS_INVENTARIO [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DDF2DD"><TR><TD COLSPAN="2" BGCOLOR="#2F4F6F"><B><FONT COLOR="white">MOVIMIENTOS_INVENTARIO</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><B>ID_Movimiento</B></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">ID_Producto</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">Fecha_Movimiento</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Tipo_Movimiento</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Cantidad</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Saldo_Resultante</TD><TD></TD></TR><TR><TD ALIGN="LEFT">ID_Compra</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">ID_Factura</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">Observacion</TD><TD></TD></TR></TABLE>>];
EMPLEADOS -> USUARIOS [arrowtail=teetee, arrowhead=crow, label="tiene"];
CATEGORIAS -> PRODUCTOS [arrowtail=teetee, arrowhead=crow, label="clasifica"];
MARCAS -> PRODUCTOS [arrowtail=teetee, arrowhead=crow, label="identifica"];
UNIDADES_MEDIDA -> PRODUCTOS [arrowtail=teetee, arrowhead=crow, label="mide"];
PROVEEDORES -> PRODUCTOS [arrowtail=teetee, arrowhead=crow, label="suministra"];
PROVEEDORES -> COMPRAS_ENCABEZADO [arrowtail=teetee, arrowhead=crow, label="vende en"];
EMPLEADOS -> COMPRAS_ENCABEZADO [arrowtail=teetee, arrowhead=crow, label="registra"];
COMPRAS_ENCABEZADO -> COMPRAS_DETALLE [arrowtail=teetee, arrowhead=crowtee, label="contiene"];
PRODUCTOS -> COMPRAS_DETALLE [arrowtail=teetee, arrowhead=crowtee, label="se compra en"];
CLIENTES -> FACTURAS_ENCABEZADO [arrowtail=teetee, arrowhead=crow, label="recibe"];
EMPLEADOS -> FACTURAS_ENCABEZADO [arrowtail=teetee, arrowhead=crow, label="emite"];
METODOS_PAGO -> FACTURAS_ENCABEZADO [arrowtail=teetee, arrowhead=crow, label="paga con"];
FACTURAS_ENCABEZADO -> FACTURAS_DETALLE [arrowtail=teetee, arrowhead=crowtee, label="contiene"];
PRODUCTOS -> FACTURAS_DETALLE [arrowtail=teetee, arrowhead=crowtee, label="se vende en"];
PRODUCTOS -> MOVIMIENTOS_INVENTARIO [arrowtail=teetee, arrowhead=crow, label="registra"];
COMPRAS_ENCABEZADO -> MOVIMIENTOS_INVENTARIO [arrowtail=teetee, arrowhead=crowodot, label="origina entrada"];
FACTURAS_ENCABEZADO -> MOVIMIENTOS_INVENTARIO [arrowtail=teetee, arrowhead=crowodot, label="origina salida"];
LEYENDA [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD ALIGN="LEFT"><B>Leyenda</B></TD></TR><TR><TD ALIGN="LEFT">PK llave primaria | FK llave foranea | UQ unica</TD></TR><TR><TD ALIGN="LEFT">Extremo con una raya doble: exactamente 1 (lado padre)</TD></TR><TR><TD ALIGN="LEFT">Pata de gallo: muchos (N) | con circulo: opcional (0..N)</TD></TR><TR><TD ALIGN="LEFT">Pata de gallo con raya: 1..N (el detalle tiene al menos una linea)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA">Catalogo</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DDF2DD">Inventario</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1CC">Compras</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FADADD">Ventas</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8E0F5">Seguridad</TD></TR></TABLE>>];
}