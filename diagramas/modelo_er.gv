CLIENTES [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DCEBFA"><TR><TD COLSPAN="2" BGCOLOR="#2F4F6F"><B><FONT COLOR="white">CLIENTES</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><B>ID_Cliente</B></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">NIT</TD><TD>UQ</TD></TR><TR><TD ALIGN="LEFT">Nombre_Completo</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Direccion</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Telefono</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Correo</TD><TD>UQ</TD></TR></TABLE>>];
EMPLEADOS [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E8E0F5"><TR><TD COLSPAN="2" BGCOLOR="#2F4F6F"><B><FONT COLOR="white">EMPLEADOS</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><B>ID_Empleado</B></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">Nombre_Completo</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Puesto</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Telefono</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Correo</TD><TD>UQ</TD></TR><TR><TD ALIGN="LEFT">Fecha_Ingreso</TD><TD></TD></TR></TABLE>>];
USUARIOS [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E8E0F5"><TR><TD COLSPAN="2" BGCOLOR="#2F4F6F"><B><FONT COLOR="white">USUARIOS</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><B>ID_Usuario</B></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">Nombre_Usuario</TD><TD>UQ</TD></TR><TR><TD ALIGN="LEFT">Contrasena_Hash</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Rol</TD><TD></TD></TR><TR><TD ALIGN="LEFT">ID_Empleado</TD><TD>FK</TD></TR></TABLE>>];
